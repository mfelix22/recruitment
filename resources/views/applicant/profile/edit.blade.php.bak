                    @foreach ($educationLevels as $el)
                        <option value="{{ $el }}">{{ $el }}</option>
                    @endforeach
                </select>
            </td>
            <td class="border px-1 py-1"><input type="text" name="__NAME_OCC__"
                    class="w-full text-xs border-0 focus:ring-1 rounded"></td>
            <td class="border px-1 py-1"><button type="button" onclick="this.closest('tr').remove()"
                    class="text-red-500 text-xs">✕</button></td>
        </tr>
    </template>

    @push('scripts')
        <script>
            // ── helpers ──────────────────────────────────────────────────────
            function nextFamilyIndex() {
                return document.querySelectorAll('[name^="family["]').length;
            }

            function addFamilyRow(type) {
                const tpl = document.getElementById('tpl-family-' + type);
                const tbody = document.getElementById(type + '-family-body');
                const idx = nextFamilyIndex();
                let html = tpl.innerHTML
                    .replace(/__IDX__/g, `family[${idx}][family_type]`)
                    .replace(/__NAME_RELATION__/g, `family[${idx}][relation]`)
                    .replace(/__NAME_NAME__/g, `family[${idx}][name]`)
                    .replace(/__NAME_GENDER__/g, `family[${idx}][gender]`)
                    .replace(/__NAME_POB__/g, `family[${idx}][place_of_birth]`)
                    .replace(/__NAME_DOB__/g, `family[${idx}][date_of_birth]`)
                    .replace(/__NAME_EDU__/g, `family[${idx}][education]`)
                    .replace(/__NAME_OCC__/g, `family[${idx}][occupation]`);
                const tmp = document.createElement('tbody');
                tmp.innerHTML = html;
                tbody.appendChild(tmp.firstElementChild);
            }

            function addTrainingRow() {
                const tbody = document.getElementById('trainings-body');
                const idx = tbody.querySelectorAll('tr').length;
                const tr = document.createElement('tr');
                tr.innerHTML =
                    `
            <td class="border px-1 py-1"><input type="text" name="trainings[${idx}][name]" class="w-full text-xs border-0 focus:ring-1 rounded"></td>
            <td class="border px-1 py-1"><input type="text" name="trainings[${idx}][organizer]" class="w-full text-xs border-0 focus:ring-1 rounded"></td>
            <td class="border px-1 py-1"><input type="text" name="trainings[${idx}][place]" class="w-full text-xs border-0 focus:ring-1 rounded"></td>
            <td class="border px-1 py-1"><input type="number" name="trainings[${idx}][year]" class="w-20 text-xs border-0 focus:ring-1 rounded"></td>
            <td class="border px-1 py-1"><input type="text" name="trainings[${idx}][notes]" class="w-full text-xs border-0 focus:ring-1 rounded"></td>
            <td class="border px-1 py-1"><button type="button" onclick="this.closest('tr').remove()" class="text-red-500 text-xs">✕</button></td>`;
                tbody.appendChild(tr);
            }

            function addLanguageRow() {
                const tbody = document.getElementById('languages-body');
                const idx = tbody.querySelectorAll('tr').length;
                const levels = @json($langLevels);
                const opts = levels.map(l => `<option value="${l}">${l}</option>`).join('');
                const tr = document.createElement('tr');
                tr.innerHTML =
                    `
            <td class="border px-1 py-1"><input type="text" name="languages[${idx}][language]" placeholder="Indonesia / Inggris / ..." class="w-full text-xs border-0 focus:ring-1 rounded"></td>
            <td class="border px-1 py-1"><select name="languages[${idx}][written_level]" class="w-full text-xs border-0 focus:ring-1 rounded">${opts}</select></td>
            <td class="border px-1 py-1"><select name="languages[${idx}][spoken_level]" class="w-full text-xs border-0 focus:ring-1 rounded">${opts}</select></td>
            <td class="border px-1 py-1"><button type="button" onclick="this.closest('tr').remove()" class="text-red-500 text-xs">✕</button></td>`;
                tbody.appendChild(tr);
            }

            function addReferenceRow() {
                const tbody = document.getElementById('references-body');
                if (tbody.querySelectorAll('tr').length >= 3) {
                    alert('Maksimal 3 referensi.');
                    return;
                }
                const idx = tbody.querySelectorAll('tr').length;
                const tr = document.createElement('tr');
                tr.innerHTML =
                    `
            <td class="border px-1 py-1"><input type="text" name="references[${idx}][name]" class="w-full text-xs border-0 focus:ring-1 rounded"></td>
            <td class="border px-1 py-1"><input type="text" name="references[${idx}][work_address]" class="w-full text-xs border-0 focus:ring-1 rounded"></td>
            <td class="border px-1 py-1"><input type="text" name="references[${idx}][position]" class="w-full text-xs border-0 focus:ring-1 rounded"></td>
            <td class="border px-1 py-1"><input type="text" name="references[${idx}][relation]" class="w-full text-xs border-0 focus:ring-1 rounded"></td>
            <td class="border px-1 py-1"><button type="button" onclick="this.closest('tr').remove()" class="text-red-500 text-xs">✕</button></td>`;
                tbody.appendChild(tr);
            }
        </script>
    @endpush

</x-layouts.applicant>
